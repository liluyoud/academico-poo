@page "/alunos"
@using Academico.Shared.Entities
@using Academico.Shared.Services
@inject IAlunoService AlunoService
@inject NavigationManager Navigation

<div class="premium-container fade-in-up">
    <div class="header-banner">
        <h1><i class="bi bi-people-fill"></i> Alunos</h1>
        <p>Gerencie o corpo discente, matrículas e informações de estudantes.</p>
    </div>

    @if (errorMsg is not null)
    {
        <div class="alert alert-danger d-flex align-items-center justify-content-between" role="alert">
            <div>
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMsg
            </div>
            <button type="button" class="btn-close" @onclick="() => errorMsg = null"></button>
        </div>
    }

    @if (successMsg is not null)
    {
        <div class="alert alert-success d-flex align-items-center justify-content-between" role="alert">
            <div>
                <i class="bi bi-check-circle-fill me-2"></i> @successMsg
            </div>
            <button type="button" class="btn-close" @onclick="() => successMsg = null"></button>
        </div>
    }

    <div class="card-premium">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="card-title-premium m-0 border-0 pb-0">Estudantes Cadastrados</h2>
            <a class="btn-premium btn-premium-primary" href="alunos/novo">
                <i class="bi bi-plus-circle"></i> Novo Aluno
            </a>
        </div>

        @if (alunos is null)
        {
            <div class="d-flex justify-content-center my-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Carregando...</span>
                </div>
            </div>
        }
        else if (alunos.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-person-x text-muted" style="font-size: 3rem;"></i>
                <p class="mt-3 text-muted">Nenhum aluno cadastrado no momento.</p>
            </div>
        }
        else
        {
            <div class="row mb-3">
                <div class="col-md-6 col-lg-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Buscar por aluno, CPF, email ou curso..." 
                               value="@searchTerm" @oninput="OnSearchInput" />
                    </div>
                </div>
            </div>

            @if (FilteredAlunos.Count == 0)
            {
                <div class="text-center py-4">
                    <p class="text-muted">Nenhum resultado encontrado para a busca "@searchTerm".</p>
                </div>
            }
            else
            {
                <div class="table-responsive-custom">
                    <table class="table table-custom">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nome</th>
                                <th>CPF</th>
                                <th>Email</th>
                                <th>Data Nasc.</th>
                                <th>Curso</th>
                                <th>Status</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var aluno in PaginatedAlunos)
                            {
                                <tr>
                                    <td>@aluno.Id</td>
                                    <td class="fw-semibold">@aluno.Nome</td>
                                    <td class="font-monospace">@aluno.Cpf</td>
                                    <td>@aluno.Email</td>
                                    <td>@aluno.DataNascimento.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge-custom badge-info font-monospace">@aluno.Curso?.Sigla</span>
                                        <span class="text-muted ms-1 small">(@aluno.Curso?.Nome)</span>
                                    </td>
                                    <td>
                                        <span class="badge-custom @GetStatusClass(aluno.StatusAluno)">
                                            @aluno.StatusAluno
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn-premium btn-premium-secondary btn-action" 
                                                @onclick="() => Editar(aluno.Id)" title="Editar">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <button class="btn-premium btn-premium-danger btn-action" 
                                                @onclick="() => ConfirmarExclusao(aluno)" title="Excluir">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Controls -->
                <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                    <div class="text-muted small">
                        Exibindo de @(((currentPage - 1) * pageSize) + 1) a @(Math.Min(currentPage * pageSize, FilteredAlunos.Count)) de @FilteredAlunos.Count registros
                    </div>
                    @if (TotalPages > 1)
                    {
                        <nav aria-label="Navegação de página">
                            <ul class="pagination pagination-sm m-0">
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => MudarPagina(currentPage - 1)">Anterior</button>
                                </li>
                                @for (int i = 1; i <= TotalPages; i++)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                        <button class="page-link" @onclick="() => MudarPagina(pageNumber)">@pageNumber</button>
                                    </li>
                                }
                                <li class="page-item @(currentPage == TotalPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => MudarPagina(currentPage + 1)">Próximo</button>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            }
        }
    </div>
</div>

@if (confirmDeleteAluno is not null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content card-premium p-0 border-0 overflow-hidden">
                <div class="modal-header bg-danger text-white border-0 py-3">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle"></i> Confirmar Exclusão</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelarExclusao"></button>
                </div>
                <div class="modal-body p-4">
                    <p>Você tem certeza que deseja excluir o aluno <strong>@confirmDeleteAluno.Nome</strong>?</p>
                    <p class="text-muted small">Esta ação é permanente e falhará caso o aluno possua matrículas em disciplinas.</p>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn-premium btn-premium-secondary" @onclick="CancelarExclusao">Cancelar</button>
                    <button type="button" class="btn-premium btn-premium-danger" @onclick="Excluir">Excluir</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Aluno>? alunos;
    private Aluno? confirmDeleteAluno;
    private string? errorMsg;
    private string? successMsg;

    // Search and Pagination fields
    private string searchTerm = "";
    private int currentPage = 1;
    private const int pageSize = 6;

    private List<Aluno> FilteredAlunos => alunos?
        .Where(a => string.IsNullOrWhiteSpace(searchTerm) || 
                    a.Nome.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || 
                    a.Cpf.Contains(searchTerm) ||
                    a.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (a.Curso != null && a.Curso.Nome.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    (a.Curso != null && a.Curso.Sigla.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    a.StatusAluno.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .ToList() ?? [];

    private List<Aluno> PaginatedAlunos => FilteredAlunos
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    private int TotalPages => (int)Math.Ceiling((double)FilteredAlunos.Count / pageSize);

    protected override async Task OnInitializedAsync()
    {
        await CarregarAlunos();
    }

    private async Task CarregarAlunos()
    {
        try
        {
            alunos = await AlunoService.GetAllAsync();
        }
        catch (Exception ex)
        {
            errorMsg = $"Erro ao carregar alunos: {ex.Message}";
        }
    }

    private void Editar(int id)
    {
        Navigation.NavigateTo($"alunos/editar/{id}");
    }

    private void ConfirmarExclusao(Aluno aluno)
    {
        confirmDeleteAluno = aluno;
    }

    private void CancelarExclusao()
    {
        confirmDeleteAluno = null;
    }

    private async Task Excluir()
    {
        if (confirmDeleteAluno is null) return;

        try
        {
            var success = await AlunoService.DeleteAsync(confirmDeleteAluno.Id);
            if (success)
            {
                successMsg = $"Aluno '{confirmDeleteAluno.Nome}' excluído com sucesso!";
                await CarregarAlunos();
                if (currentPage > TotalPages && currentPage > 1)
                {
                    currentPage = TotalPages;
                }
            }
            else
            {
                errorMsg = "Não foi possível excluir o aluno. Certifique-se de que ele não possui matrículas ativas em nenhuma disciplina.";
            }
        }
        catch (Exception ex)
        {
            errorMsg = $"Erro ao excluir aluno: {ex.Message}";
        }
        finally
        {
            confirmDeleteAluno = null;
        }
    }

    private string GetStatusClass(string status)
    {
        return status.ToLower() switch
        {
            "ativo" => "badge-active",
            "inativo" => "badge-inactive",
            "trancado" => "badge-warning",
            _ => "badge-info"
        };
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        currentPage = 1;
    }

    private void MudarPagina(int novaPagina)
    {
        if (novaPagina >= 1 && novaPagina <= TotalPages)
        {
            currentPage = novaPagina;
        }
    }
}
