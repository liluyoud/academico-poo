@page "/matriculas"
@using Academico.Shared.Entities
@using Academico.Shared.Services
@inject IMatriculaService MatriculaService
@inject NavigationManager Navigation

<div class="premium-container fade-in-up">
    <div class="header-banner">
        <h1><i class="bi bi-card-checklist"></i> Matrículas</h1>
        <p>Acompanhe inscrições, gerencie notas finais e controle as situações acadêmicas.</p>
    </div>

    @if (errorMsg is not null)
    {
        <div class="alert alert-danger d-flex align-items-center justify-content-between" role="alert">
            <div>
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMsg
            </div>
            <button type="button" class="btn-close" @onclick="() => errorMsg = null"></button>
        </div>
    }

    @if (successMsg is not null)
    {
        <div class="alert alert-success d-flex align-items-center justify-content-between" role="alert">
            <div>
                <i class="bi bi-check-circle-fill me-2"></i> @successMsg
            </div>
            <button type="button" class="btn-close" @onclick="() => successMsg = null"></button>
        </div>
    }

    <div class="card-premium">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="card-title-premium m-0 border-0 pb-0">Histórico de Matrículas</h2>
            <a class="btn-premium btn-premium-primary" href="matriculas/novo">
                <i class="bi bi-plus-circle"></i> Efetuar Matrícula
            </a>
        </div>

        @if (matriculas is null)
        {
            <div class="d-flex justify-content-center my-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Carregando...</span>
                </div>
            </div>
        }
        else if (matriculas.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-journal-check text-muted" style="font-size: 3rem;"></i>
                <p class="mt-3 text-muted">Nenhuma matrícula registrada no momento.</p>
            </div>
        }
        else
        {
            <div class="row mb-3">
                <div class="col-md-6 col-lg-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Buscar por aluno, disciplina ou situação..." 
                               value="@searchTerm" @oninput="OnSearchInput" />
                    </div>
                </div>
            </div>

            @if (FilteredMatriculas.Count == 0)
            {
                <div class="text-center py-4">
                    <p class="text-muted">Nenhum resultado encontrado para a busca "@searchTerm".</p>
                </div>
            }
            else
            {
                <div class="table-responsive-custom">
                    <table class="table table-custom">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Aluno</th>
                                <th>Curso / Disciplina</th>
                                <th>Data Matrícula</th>
                                <th>Nota Final</th>
                                <th>Status</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mat in PaginatedMatriculas)
                            {
                                <tr>
                                    <td>@mat.Id</td>
                                    <td class="fw-semibold">
                                        <i class="bi bi-person-fill text-muted me-1"></i>
                                        @mat.Aluno?.Nome
                                    </td>
                                    <td>
                                        <span class="badge-custom badge-info font-monospace me-1">
                                            @mat.Disciplina?.Curso?.Sigla
                                        </span>
                                        <span class="fw-semibold">@mat.Disciplina?.Nome</span>
                                    </td>
                                    <td>@mat.DataMatricula.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (mat.NotaFinal.HasValue)
                                        {
                                            <span class="fw-bold">@mat.NotaFinal.Value.ToString("F2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted font-italic">-</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge-custom @GetStatusClass(mat.StatusMatricula)">
                                            @mat.StatusMatricula
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn-premium btn-premium-secondary btn-action" 
                                                @onclick="() => Editar(mat.Id)" title="Lançar Nota / Editar">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <button class="btn-premium btn-premium-danger btn-action" 
                                                @onclick="() => ConfirmarExclusao(mat)" title="Excluir">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Controls -->
                <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                    <div class="text-muted small">
                        Exibindo de @(((currentPage - 1) * pageSize) + 1) a @(Math.Min(currentPage * pageSize, FilteredMatriculas.Count)) de @FilteredMatriculas.Count registros
                    </div>
                    @if (TotalPages > 1)
                    {
                        <nav aria-label="Navegação de página">
                            <ul class="pagination pagination-sm m-0">
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => MudarPagina(currentPage - 1)">Anterior</button>
                                </li>
                                @for (int i = 1; i <= TotalPages; i++)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                        <button class="page-link" @onclick="() => MudarPagina(pageNumber)">@pageNumber</button>
                                    </li>
                                }
                                <li class="page-item @(currentPage == TotalPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => MudarPagina(currentPage + 1)">Próximo</button>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            }
        }
    </div>
</div>

@if (confirmDeleteMatricula is not null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content card-premium p-0 border-0 overflow-hidden">
                <div class="modal-header bg-danger text-white border-0 py-3">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle"></i> Confirmar Cancelamento</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelarExclusao"></button>
                </div>
                <div class="modal-body p-4">
                    <p>Tem certeza que deseja cancelar a matrícula do aluno <strong>@confirmDeleteMatricula.Aluno?.Nome</strong> na disciplina <strong>@confirmDeleteMatricula.Disciplina?.Nome</strong>?</p>
                    <p class="text-muted small">Esta ação é permanente e remove o histórico de notas correspondente.</p>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn-premium btn-premium-secondary" @onclick="CancelarExclusao">Cancelar</button>
                    <button type="button" class="btn-premium btn-premium-danger" @onclick="Excluir">Remover</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Matricula>? matriculas;
    private Matricula? confirmDeleteMatricula;
    private string? errorMsg;
    private string? successMsg;

    // Search and Pagination fields
    private string searchTerm = "";
    private int currentPage = 1;
    private const int pageSize = 6;

    private List<Matricula> FilteredMatriculas => matriculas?
        .Where(m => string.IsNullOrWhiteSpace(searchTerm) || 
                    (m.Aluno != null && m.Aluno.Nome.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) || 
                    (m.Disciplina != null && m.Disciplina.Nome.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    (m.Disciplina != null && m.Disciplina.Curso != null && m.Disciplina.Curso.Sigla.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    m.StatusMatricula.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .ToList() ?? [];

    private List<Matricula> PaginatedMatriculas => FilteredMatriculas
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    private int TotalPages => (int)Math.Ceiling((double)FilteredMatriculas.Count / pageSize);

    protected override async Task OnInitializedAsync()
    {
        await CarregarMatriculas();
    }

    private async Task CarregarMatriculas()
    {
        try
        {
            matriculas = await MatriculaService.GetAllAsync();
        }
        catch (Exception ex)
        {
            errorMsg = $"Erro ao carregar matrículas: {ex.Message}";
        }
    }

    private void Editar(int id)
    {
        Navigation.NavigateTo($"matriculas/editar/{id}");
    }

    private void ConfirmarExclusao(Matricula mat)
    {
        confirmDeleteMatricula = mat;
    }

    private void CancelarExclusao()
    {
        confirmDeleteMatricula = null;
    }

    private async Task Excluir()
    {
        if (confirmDeleteMatricula is null) return;

        try
        {
            var success = await MatriculaService.DeleteAsync(confirmDeleteMatricula.Id);
            if (success)
            {
                successMsg = "Matrícula excluída/cancelada com sucesso!";
                await CarregarMatriculas();
                if (currentPage > TotalPages && currentPage > 1)
                {
                    currentPage = TotalPages;
                }
            }
            else
            {
                errorMsg = "Não foi possível excluir a matrícula.";
            }
        }
        catch (Exception ex)
        {
            errorMsg = $"Erro ao excluir matrícula: {ex.Message}";
        }
        finally
        {
            confirmDeleteMatricula = null;
        }
    }

    private string GetStatusClass(string status)
    {
        return status.ToLower() switch
        {
            "cursando" => "badge-info",
            "aprovado" => "badge-active",
            "reprovado" => "badge-inactive",
            _ => "badge-warning"
        };
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        currentPage = 1;
    }

    private void MudarPagina(int novaPagina)
    {
        if (novaPagina >= 1 && novaPagina <= TotalPages)
        {
            currentPage = novaPagina;
        }
    }
}
